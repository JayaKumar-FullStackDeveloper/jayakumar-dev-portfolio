# Copy to .env.local (git-ignored) and fill in from Firebase Console →
# Project settings → Your apps → Web app. Set the same four variables in Netlify.
# This is a Create React App project, so only REACT_APP_* variables reach the browser.
# These values are public by design; never put service-account keys or secrets here.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=portfolio-f3161.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=portfolio-f3161
REACT_APP_FIREBASE_APP_ID=
